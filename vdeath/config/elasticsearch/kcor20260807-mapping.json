{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "max_result_window": 1000000,
    "refresh_interval": "30s"
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "id":                         { "type": "keyword" },
      "series":                     { "type": "keyword" },
      "method":                     { "type": "keyword" },
      "areacode":                   { "type": "keyword" },
      "area":                       { "type": "keyword" },
      "areaj":                      { "type": "keyword" },
      "cutoff":                     { "type": "date", "format": "strict_date" },
      "cweek":                      { "type": "keyword" },
      "date":                       { "type": "date", "format": "strict_date" },
      "age":                        { "type": "keyword" },
      "dose":                       { "type": "byte" },
      "deaths":                     { "type": "integer" },
      "cohort_size":                { "type": "integer" },
      "at_risk":                    { "type": "integer" },
      "deaths_week":                { "type": "integer" },
      "censored_week":              { "type": "integer" },
      "quiet_start":                { "type": "date", "format": "strict_date" },
      "quiet_end":                  { "type": "date", "format": "strict_date" },
      "points":                     { "type": "integer" },
      "theta":                      { "type": "double" },
      "k":                          { "type": "double" },
      "rmse":                       { "type": "double" },
      "fit_status":                 { "type": "keyword" },
      "hazard":                     { "type": "double" },
      "observed_cumulative_hazard": { "type": "double" },
      "adjusted_cumulative_hazard": { "type": "double" }
    }
  }
}
